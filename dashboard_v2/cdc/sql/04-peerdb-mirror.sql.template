  tenant_bvcahn.csyt_benh_an_dieu_tri:raw_csyt_benh_an_dieu_tri,
  tenant_bvcahn.csyt_phieu_ra_vien:raw_csyt_phieu_ra_vien,
  tenant_bvcahn.phieu_dich_vu_chi_tiet:raw_phieu_dich_vu_chi_tiet,
  tenant_bvcahn.csyt_yl_thuocvt:raw_csyt_yl_thuocvt,
  tenant_bvcahn.csyt_vien_phi_chung_tu:raw_csyt_vien_phi_chung_tu,
  tenant_bvcahn.csyt_vien_phi_chung_tu_chi_tiet:raw_csyt_vien_phi_chung_tu_chi_tiet,
  tenant_bvcahn.dm_so_thu_hoa_don:raw_dm_so_thu_hoa_don,
