# Copy this file to compose.yaml, then set CLICKHOUSE_PASSWORD in .env.
# Optional deployment overrides in .env:
#   CLICKHOUSE_BIND_ADDR=127.0.0.1
#   CDC_NETWORK_NAME=hms_cdc

services:
  clickhouse:
    image: clickhouse/clickhouse-server:26.10.2.103
    restart: unless-stopped
    environment:
      CLICKHOUSE_DB: hms
      CLICKHOUSE_USER: admin
      CLICKHOUSE_PASSWORD: ${CLICKHOUSE_PASSWORD:?copy .env.example to .env and set CLICKHOUSE_PASSWORD}
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: "1"
    ports:
      # Keep ClickHouse private by default. Set CLICKHOUSE_BIND_ADDR to a
      # firewall-protected private address only when remote access is required.
      - "${CLICKHOUSE_BIND_ADDR:-127.0.0.1}:8123:8123"
      - "${CLICKHOUSE_BIND_ADDR:-127.0.0.1}:9000:9000"
    volumes:
      - clickhouse_data:/var/lib/clickhouse
      - ./clickhouse/users.d/admin-access.xml:/etc/clickhouse-server/users.d/admin-access.xml:ro
    networks: [hms_cdc]
    healthcheck:
      test: ["CMD-SHELL", "clickhouse-client --user admin --password $$CLICKHOUSE_PASSWORD --query 'SELECT 1'"]
      interval: 10s
      timeout: 5s
      retries: 12

volumes:
  clickhouse_data:

networks:
  hms_cdc:
    name: ${CDC_NETWORK_NAME:-hms_cdc}
