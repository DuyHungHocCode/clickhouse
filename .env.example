# Copy to .env before starting the lab. Replace local-only secrets before sharing this file.
COMPOSE_PROJECT_NAME=hms-analytics-lab

HMS_POSTGRES_IMAGE=postgres:16-alpine
HMS_POSTGRES_PORT=127.0.0.1:5432
HMS_POSTGRES_PASSWORD=change-me-hms-owner
PEERDB_SOURCE_USER=peerdb_user
PEERDB_SOURCE_PASSWORD=change-me-peerdb-source

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
CLICKHOUSE_HTTP_PORT=127.0.0.1:8123
CLICKHOUSE_NATIVE_PORT=127.0.0.1:9000
CLICKHOUSE_DEFAULT_PASSWORD=change-me-clickhouse-admin
PEERDB_CLICKHOUSE_USER=peerdb_user
PEERDB_CLICKHOUSE_PASSWORD=change-me-peerdb-clickhouse
SUPERSET_CLICKHOUSE_USER=superset_user
SUPERSET_CLICKHOUSE_PASSWORD=change-me-superset-clickhouse
CLICKHOUSE_MEMORY_LIMIT=6g

PEERDB_VERSION=stable-v0.37.12
PEERDB_UI_PORT=127.0.0.1:3000
PEERDB_SERVER_PORT=127.0.0.1:9900
PEERDB_FLOW_API_PORT=127.0.0.1:8112
PEERDB_FLOW_HTTP_PORT=127.0.0.1:8113
PEERDB_CATALOG_PORT=127.0.0.1:9901
PEERDB_CATALOG_PASSWORD=change-me-peerdb-catalog
PEERDB_PASSWORD=change-me-peerdb
TEMPORAL_UI_PORT=127.0.0.1:8085
MINIO_API_PORT=127.0.0.1:9001
MINIO_CONSOLE_PORT=127.0.0.1:9002
MINIO_ROOT_USER=peerdb-minio
MINIO_ROOT_PASSWORD=change-me-minio

SUPERSET_IMAGE=apache/superset:4.1.1
SUPERSET_PORT=127.0.0.1:8088
SUPERSET_SECRET_KEY=change-me-superset-secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin
SUPERSET_ADMIN_EMAIL=admin@local.test
