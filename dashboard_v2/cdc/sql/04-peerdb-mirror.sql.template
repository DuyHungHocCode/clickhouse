CREATE PEER hms_source FROM POSTGRES WITH (
  host = '__HMS_SOURCE_HOST__',
  port = __HMS_SOURCE_PORT__,
  user = '__HMS_SOURCE_USER__',
  password = '__HMS_SOURCE_PASSWORD__',
  database = '__HMS_SOURCE_DATABASE__'
);

CREATE PEER hms_raw FROM CLICKHOUSE WITH (
  host = 'clickhouse',
  port = 9000,
  user = 'peerdb_hms',
  password = '__PEERDB_CLICKHOUSE_PASSWORD__',
  database = 'hms_raw',
  disable_tls = true
);

CREATE MIRROR hms_pg_to_ch_raw
FROM hms_source TO hms_raw
WITH TABLE MAPPING (
  tenant_bvcahn.tiep_nhan:raw_tiep_nhan,
  tenant_bvcahn.benh_nhan_tiep_nhan:raw_benh_nhan_tiep_nhan,
  tenant_bvcahn.benh_nhan_dot_dieu_tri:raw_benh_nhan_dot_dieu_tri,
